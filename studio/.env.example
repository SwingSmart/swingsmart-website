# Existing SwingSmart UK Sanity project. Do not create a new project.
SANITY_STUDIO_PROJECT_ID=3sbwydux
SANITY_STUDIO_DATASET=production
SANITY_STUDIO_API_VERSION=2025-02-19

# Website used by Website preview / Presentation.
# Local Studio defaults to http://localhost:3000.
# A hosted Studio defaults to https://www.swingsmart.co.uk.
SANITY_STUDIO_PREVIEW_ORIGIN=http://localhost:3000

# Hosted Studio hostname → https://swingsmart.sanity.studio
SANITY_STUDIO_HOSTNAME=swingsmart

# Optional. Set to true to show Developer tools (GROQ).
# SANITY_STUDIO_SHOW_VISION=true
