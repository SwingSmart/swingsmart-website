# Public site URL (no trailing slash). Used for canonical URLs, sitemap, Open Graph and website preview.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Sanity project — create at https://www.sanity.io/manage then paste the IDs here.
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2025-02-19

# Viewer token (read published + drafts). Needed for Website preview and live editing.
# Create under API → Tokens with “Viewer” access. Do not commit the real token.
SANITY_API_READ_TOKEN=

# Editor token with create permission. Used so the contact form can save enquiries,
# and so `npm run seed` can add starter content.
SANITY_API_WRITE_TOKEN=

# Optional. Set to true to show Developer tools (GROQ) in the Studio. Leave unset for day-to-day editing.
# SANITY_STUDIO_SHOW_VISION=true

# After creating the project, add a CORS origin in Sanity:
# API → CORS origins → http://localhost:3000 with “Allow credentials” ticked.
# On Vercel, add your live domain the same way (for example https://swingsmart.co.uk).
