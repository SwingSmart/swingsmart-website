# Public site URL (no trailing slash). Used for canonical URLs, sitemap, Open Graph and website preview.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Public frontend URL used by the hosted Studio Presentation tool.
# Must be a deployed origin (Vercel), not localhost, for https://swingsmart-cms.sanity.studio/
# SANITY_STUDIO_PREVIEW_URL=https://your-frontend.vercel.app

# Hosted Studio. Used for click-to-edit links. No workspace path.
NEXT_PUBLIC_SANITY_STUDIO_URL=https://swingsmart-cms.sanity.studio

# Sanity project (SwingSmart UK).
NEXT_PUBLIC_SANITY_PROJECT_ID=3sbwydux
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2025-02-19

# Sanity organisation (manage.sanity.io). Used only for CLI/admin, not by the website.
# SANITY_ORGANIZATION_ID=oemaxe8vm

# Personal or Editor token (Account → API / personal tokens, or project tokens).
# Used by `npm run sanity:setup` and `npm run migrate:content -- --write`.
# Create permission is enough for the migration. Do not commit the real token.
# SANITY_AUTH_TOKEN=

# Viewer token (read published + drafts). Needed for Website preview and live editing.
# Create under API → Tokens with “Viewer” access. Do not commit the real token.
SANITY_API_READ_TOKEN=

# Editor token with create permission. Used so the contact form can save enquiries.
SANITY_API_WRITE_TOKEN=

# Optional. Set to true to show Developer tools (GROQ) in the Studio. Leave unset for day-to-day editing.
# SANITY_STUDIO_SHOW_VISION=true

# Sanity CORS (Allow credentials) for this Next app:
# http://localhost:3000
# https://swingsmart-cms.sanity.studio
# Plus the public Vercel frontend origin used in SANITY_STUDIO_PREVIEW_URL
# https://www.sanity.io/manage/project/3sbwydux/api
