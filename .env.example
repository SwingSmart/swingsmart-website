# Public site URL (no trailing slash). Used for canonical URLs, sitemap and Open Graph.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Sanity project (create at https://www.sanity.io/manage)
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2025-02-19

# Viewer token with read access to published + drafts (Visual Editing / live preview).
SANITY_API_READ_TOKEN=

# Editor token with create permission, used only by the contact form to save enquiries.
SANITY_API_WRITE_TOKEN=
