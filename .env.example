# Public site URL (no trailing slash). Used for canonical URLs, sitemap, Open Graph and website preview.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Sanity project (SwingSmart UK).
NEXT_PUBLIC_SANITY_PROJECT_ID=3sbwydux
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2025-02-19

# Sanity organisation (manage.sanity.io). Used only for CLI/admin, not by the website.
# SANITY_ORGANIZATION_ID=oemaxe8vm

# Optional personal token (Account → API / personal tokens). Lets `npm run sanity:setup`
# add CORS and create the two project tokens below.
# SANITY_AUTH_TOKEN=

# Viewer token (read published + drafts). Needed for Website preview and live editing.
# Create under API → Tokens with “Viewer” access. Do not commit the real token.
SANITY_API_READ_TOKEN=

# Editor token with create permission. Used so the contact form can save enquiries,
# and so `npm run seed` can add starter content.
SANITY_API_WRITE_TOKEN=

# Optional. Set to true to show Developer tools (GROQ) in the Studio. Leave unset for day-to-day editing.
# SANITY_STUDIO_SHOW_VISION=true

# Sanity CORS (Allow credentials) for this Next app:
# http://localhost:3000
# http://localhost:3333 is Sanity’s default Studio port — keep it if you use it.
# https://www.sanity.io/manage/project/3sbwydux/api
# On Vercel, add your live domain (for example https://swingsmart.co.uk).
